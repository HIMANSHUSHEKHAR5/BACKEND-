<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDIT USENAME</title>
    <STYLE>
    body{
        background-color:rgb(132, 2, 132);   
    }
    form{
        background-color: antiquewhite;
    }

    h2{
        color: white;
    }
    btn{
color: white;
background-color: darkblue;
    }
    </STYLE>
</head>
<body>
    <h2>You are about to edit this user:<%=user.email%></h2>
    <form  method="POST" action="/user/<%=user.id%>/edit?_method=PATCH">
        <textarea name="user_name"><%=user.user_name%></textarea>
        <br>
        <input type="password" name="password" placeholder="enter password" />
        <hr>
    
            <button>Save changes</button>
    </form>
</body>
</html>